# Core app
APP_ENV=development
SANGO_CONFIG_FILE=
BIND_ADDR=0.0.0.0:8080
BACKEND_PORT=8080
FRONTEND_PORT=4200
SANGO_SECRET_KEY=replace-with-a-long-random-secret
SANGO_DB_PUSH_SCHEMA=true
SANGO_DOCS_ENABLED=true
SANGO_REMOTE_SERVICES_ROOT=/opt/sango/services
SANGO_DOCKERFILE_CONTEXT_DIR=context
SANGO_JWT_PRIVATE_KEY_PEM=
SANGO_JWT_PUBLIC_KEY_PEM=
SANGO_JWT_ISSUER=sango
SANGO_JWT_AUDIENCE=sango-api
SANGO_JWT_ACCESS_TOKEN_TTL_SECONDS=900
SANGO_APP_BASE_URL=http://localhost:4200
SANGO_INVITE_TOKEN_TTL_SECONDS=604800
SANGO_BOOTSTRAP_ADMIN_EMAIL=admin@sango.local
SANGO_BOOTSTRAP_ADMIN_PASSWORD=change-me
SANGO_BOOTSTRAP_ADMIN_NAME=Sango Admin

# Sango PostgreSQL
POSTGRES_USER=sango
POSTGRES_PASSWORD=sango
POSTGRES_DB=sango
POSTGRES_PORT=5432
DATABASE_URL=postgres://sango:sango@localhost:5432/sango

# Platform telemetry, disabled by default
SANGO_TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=sango-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Temporal client settings used by backend and workers
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_NAMESPACES=default

# Temporal deployment settings
TEMPORAL_VERSION=1.30.1
TEMPORAL_UI_VERSION=2.34.0
TEMPORAL_POSTGRESQL_VERSION=16
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal
TEMPORAL_POSTGRES_PORT=5432
TEMPORAL_FRONTEND_PORT=7233
TEMPORAL_UI_PORT=8081
TEMPORAL_UI_CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Optional local observability stack
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
JAEGER_GRPC_PORT=4317
JAEGER_HTTP_PORT=4318
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=changeme
ELASTIC_PORT=9200
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Tests only
SANGO_TEST_DATABASE_URL=postgres://sango:sango@localhost:5432/sango

# The backend also reads ~/.sango/config.yml. Set SANGO_CONFIG_FILE to point at
# a different file. Environment variables override file values and are what the
# Docker Compose deployment injects by default.
